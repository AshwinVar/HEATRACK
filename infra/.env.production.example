# ---- infra/.env.production (docker-compose.prod.yml) ---------------------------------
# Placeholders only. Copy to .env.production on the server, chmod 600, never commit.
FP_APP_ENV=production

# Supabase -> Project Settings -> Database -> Connection string (use the pooler/session URI)
FP_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=require

# Supabase Auth (asymmetric JWT signing keys)
FP_AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
FP_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
FP_AUTH_AUDIENCE=authenticated
# Legacy HS256 projects only (prefer JWKS):
# FP_AUTH_JWT_SECRET=<legacy-jwt-secret>

FP_DEV_TOKEN_MINT_ENABLED=false

# Firebase Admin SDK service account (mounted read-only into the worker container)
FP_PUSH_TRANSPORT=fcm
FP_FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json

FP_CORS_ORIGINS=["https://<web-domain>"]

# Engineering freshness budgets (seconds) - tune after observing real export cadence
FP_FRESHNESS_HEART_RATE_S=10800
FP_HEARTBEAT_STALE_S=21600
